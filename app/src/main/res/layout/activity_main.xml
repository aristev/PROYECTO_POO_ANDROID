<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_coliseo"
    tools:context=".MainActivity">

    <!-- CONTENEDOR DEL TÍTULO -->
    <LinearLayout
        android:id="@+id/containerTitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="50dp">

        <TextView
            android:id="@+id/tvBattle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BATTLE"
            android:fontFamily="@font/press_start_2p"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#C0C0C0"
            android:shadowColor="#FF000000"
            android:shadowDx="6"
            android:shadowDy="6"
            android:shadowRadius="1" />

        <TextView
            android:id="@+id/tvRetro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RETRO"
            android:fontFamily="@font/press_start_2p"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#FFD700"
            android:shadowColor="#FF000000"
            android:shadowDx="6"
            android:shadowDy="6"
            android:shadowRadius="1"
            android:layout_marginTop="-2dp" />

        <TextView
            android:id="@+id/tvUnete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="¡ÚNETE A LA\nBATALLA AHORA!"
            android:fontFamily="@font/press_start_2p"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFAA00"
            android:lineSpacingExtra="6dp"
            android:shadowColor="#FF000000"
            android:shadowDx="5"
            android:shadowDy="5"
            android:shadowRadius="1"
            android:layout_marginTop="24dp" />
    </LinearLayout>

    <!-- BOTÓN EMPEZAR BATALLA -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnEmpezarBatalla"
        android:layout_width="280dp"
        android:layout_height="65dp"
        android:background="@drawable/btn_retro_rojo_fondo"
        android:fontFamily="@font/press_start_2p"
        android:lineSpacingExtra="4dp"
        android:shadowColor="#FF000000"
        android:shadowDx="3"
        android:shadowDy="3"
        android:shadowRadius="2"
        android:text="¡EMPEZAR LA\nBATALLA!"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/btnSalir"
        android:layout_marginBottom="12dp" />

    <!-- BOTÓN SALIR (Altura de 48dp reglamentaria) -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSalir"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:background="@drawable/btn_retro_rojo_fondo"
        android:fontFamily="@font/press_start_2p"
        android:shadowColor="#FF000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="1"
        android:text="SALIR"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp" />

</androidx.constraintlayout.widget.ConstraintLayout>