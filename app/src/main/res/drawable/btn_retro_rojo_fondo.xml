<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Capa 1: El borde amarillo grueso -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="40dp" />
            <solid android:color="#FFD700" />
        </shape>
    </item>
    <!-- Capa 2: El fondo rojo degradado con la forma de cápsula -->
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="37dp" />
            <gradient
                android:angle="270"
                android:endColor="#800000"
                android:startColor="#FF0000" />
        </shape>
    </item>
</layer-list>